uint b_a32_sub_rel(uint64_t p, uint v) { return atomicAdd(b_heap32[uint(p / 4ul)], 0u - v, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease); }
