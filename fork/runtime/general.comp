uint b_a32_cmpx(uint64_t p, uint x, uint v) { return atomicCompSwap(b_heap32[uint(p / 4ul)], x, v, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease, gl_StorageSemanticsBuffer, gl_SemanticsAcquire); }
