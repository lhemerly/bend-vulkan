uint b_a32_fadd(uint64_t p, uint v) { uint old = b_a32_load(p); for (;;) { uint expected = old; if (b_a32_cas(p, old, floatBitsToUint(uintBitsToFloat(old) + uintBitsToFloat(v)))) return expected; } }
